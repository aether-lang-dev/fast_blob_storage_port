// internal.s3.mgmt — setup (bootstrap) + management JSON API handlers
// (port of internal/setup + internal/management). Registered alongside
// the S3 routes on the same server. JSON responses are hand-built.
//
// Loopback note: the Go setup endpoints are loopback-only via RemoteAddr.
// Aether's http server exposes no peer IP, and the server binds
// 127.0.0.1 by default, so we treat setup as host-local (matching the
// documented "call from the server host" bootstrap flow).

import std.http
import std.string
import std.json
import contrib.sqlite
import schema
import users
import buckets
import objects
import management
import auth
import tokens
import region
import std.uuid
import s3server (AppCtx)

_new_uuid() -> string {
    u, e = uuid.v4()
    return u
}

exports (register_mgmt_routes)


_json(res: ptr, status: int, body: string) {
    http.response_set_status(res, status)
    http.response_set_header(res, "Content-Type", "application/json")
    http.response_set_body(res, body)
}

// Authenticate + require admin. Returns (user_id, "") or ("", err).
_require_admin(ctx: *AppCtx, req: ptr) -> {
    hdr = http.get_header(req, "Authorization")
    if hdr == null { return "", "unauthorized" }
    prefix = "Bearer "
    if string.starts_with(hdr, prefix) == 0 { return "", "unauthorized" }
    token = string.substring(hdr, string.length(prefix), string.length(hdr))
    ak, sec, berr = auth.split_bearer(token)
    if berr != "" { return "", "unauthorized" }
    db = ctx.db
    hash, herr = users.user_get_secret_hash(db, ak)
    if herr != "" { return "", "unauthorized" }
    if auth.verify_secret(sec, hash) != 1 { return "", "unauthorized" }
    uid, role, active, gerr = users.user_get_by_access_key(db, ak)
    if gerr != "" { return "", "unauthorized" }
    if string.equals(role, "admin") == 0 { return "", "forbidden" }
    return uid, ""
}

// Encode a freshly-built json object, free it, and return the string.
_encode(root: ptr) -> string {
    out, e = json.encode(root)
    json.free(root)
    return out
}

// One-field {"error": msg} body.
_error_json(msg: string) -> string {
    root = json.obj()
    json.set(root, "error", json.str(msg))
    return _encode(root)
}

// GET /api/setup/status
handle_setup_status(req: ptr, res: ptr, ud: ptr) {
    ctx = ud as *AppCtx
    db = ctx.db
    n = users.user_count(db)
    required = 0
    if n == 0 { required = 1 }
    root = json.obj()
    json.set(root, "bootstrap_required", json.boolean(required))
    json.set(root, "region", json.str(region.REGION))
    _json(res, 200, _encode(root))
}

// POST /api/setup/bootstrap — create first admin, return creds JSON once.
handle_bootstrap(req: ptr, res: ptr, ud: ptr) {
    ctx = ud as *AppCtx
    db = ctx.db
    if users.user_count(db) > 0 {
        _json(res, 409, _error_json("users already exist"))
        return
    }
    ak, raw, hash = tokens.issue_bearer()
    sak, ssecret = tokens.issue_sigv4()
    uid = _new_uuid()
    cerr = users.user_insert(db, uid, "Initial Admin", ak, hash, sak, ssecret, "admin", 1, "", "")
    if cerr != "" {
        _json(res, 500, _error_json("failed to create admin"))
        return
    }
    // std.json escapes the credential strings (which can contain any
    // character) correctly — the hand-concat version assumed they were
    // JSON-safe.
    root = json.obj()
    json.set(root, "bearer_token", json.str(raw))
    json.set(root, "sigv4_access_key_id", json.str(sak))
    json.set(root, "sigv4_secret_key", json.str(ssecret))
    json.set(root, "region", json.str(region.REGION))
    _json(res, 201, _encode(root))
}

// GET /api/management/metrics
handle_metrics(req: ptr, res: ptr, ud: ptr) {
    ctx = ud as *AppCtx
    uid, aerr = _require_admin(ctx, req)
    if aerr != "" {
        st = 401
        if string.equals(aerr, "forbidden") == 1 { st = 403 }
        _json(res, st, _error_json("unauthorized"))
        return
    }
    db = ctx.db
    bc, oc, ob, uc, auc = management.metrics(db)
    // MODERNIZED (ae 0.265.0): json.from_int (#628 follow-up, sourced
    // from this repo's metrics) emits a plain integer — no scientific
    // notation, full int64 — so metrics now use the std.json encoder
    // like the rest of the API (was hand-concatenated to dodge num()'s
    // float-only %g rendering of total_object_bytes).
    root = json.obj()
    json.set(root, "bucket_count", json.from_int(bc))
    json.set(root, "object_count", json.from_int(oc))
    json.set(root, "total_object_bytes", json.from_int(ob))
    json.set(root, "user_count", json.from_int(uc))
    json.set(root, "active_user_count", json.from_int(auc))
    _json(res, 200, _encode(root))
}

register_mgmt_routes(server: ptr, ctx: ptr) {
    http.server_get(server, "/api/setup/status", handle_setup_status, ctx)
    http.server_post(server, "/api/setup/bootstrap", handle_bootstrap, ctx)
    http.server_get(server, "/api/management/metrics", handle_metrics, ctx)
}
