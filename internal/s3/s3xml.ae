// internal.s3.s3xml — hand-written S3 XML response builders + the
// multipart ETag. Aether has no XML encoder; S3's response bodies have
// a fixed shape, so we emit them directly. Values that may contain XML
// metacharacters (keys, bucket names) are escaped via xml_escape.

import std.string
import std.cryptography
import std.bytes

exports (
    xml_escape, xml_decl,
    error_xml,
    list_all_buckets_xml, bucket_entry_xml,
    list_bucket_v2_open, list_bucket_contents_xml, list_bucket_v2_close,
    initiate_mpu_xml, complete_mpu_xml, copy_object_xml, delete_result_open,
    delete_result_deleted_xml, delete_result_close, location_constraint_xml,
    multipart_etag
)

const XMLNS = "http://s3.amazonaws.com/doc/2006-03-01/"

// Escape &, <, >, ", ' for XML text/attribute content.
xml_escape(s: string) -> string {
    out = _replace(s, "&", "&amp;")
    out = _replace(out, "<", "&lt;")
    out = _replace(out, ">", "&gt;")
    out = _replace(out, "\"", "&quot;")
    out = _replace(out, "'", "&apos;")
    return out
}

_replace(s: string, from: string, to: string) -> string {
    parts = string.split(s, from)
    n = string.array_size(parts)
    out = ""
    i = 0
    while i < n {
        seg = string.array_get(parts, i)
        if i == 0 { out = string.copy(seg) }
        else { out = string.concat(out, string.concat(to, seg)) }
        i = i + 1
    }
    string.array_free(parts)
    return out
}

xml_decl() -> string {
    return "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
}

// S3 <Error> body.
error_xml(code: string, msg: string, resource: string) -> string {
    out = xml_decl()
    out = string.concat(out, "<Error><Code>")
    out = string.concat(out, xml_escape(code))
    out = string.concat(out, "</Code><Message>")
    out = string.concat(out, xml_escape(msg))
    out = string.concat(out, "</Message><Resource>")
    out = string.concat(out, xml_escape(resource))
    out = string.concat(out, "</Resource><RequestId>local-0001</RequestId></Error>")
    return out
}

// ListAllMyBucketsResult. `bucket_entries` is the pre-built concatenation
// of bucket_entry_xml() fragments.
list_all_buckets_xml(owner_id: string, display_name: string, bucket_entries: string) -> string {
    out = xml_decl()
    out = string.concat(out, "<ListAllMyBucketsResult xmlns=\"")
    out = string.concat(out, XMLNS)
    out = string.concat(out, "\"><Owner><ID>")
    out = string.concat(out, xml_escape(owner_id))
    out = string.concat(out, "</ID><DisplayName>")
    out = string.concat(out, xml_escape(display_name))
    out = string.concat(out, "</DisplayName></Owner><Buckets>")
    out = string.concat(out, bucket_entries)
    out = string.concat(out, "</Buckets></ListAllMyBucketsResult>")
    return out
}

bucket_entry_xml(name: string, creation_date: string) -> string {
    out = "<Bucket><Name>"
    out = string.concat(out, xml_escape(name))
    out = string.concat(out, "</Name><CreationDate>")
    out = string.concat(out, creation_date)
    out = string.concat(out, "</CreationDate></Bucket>")
    return out
}

// ListBucketResult (v2) — opening, per-object <Contents>, closing.
list_bucket_v2_open(bucket: string, prefix: string, key_count: int, max_keys: int, is_truncated: int) -> string {
    out = xml_decl()
    out = string.concat(out, "<ListBucketResult xmlns=\"")
    out = string.concat(out, XMLNS)
    out = string.concat(out, "\"><Name>")
    out = string.concat(out, xml_escape(bucket))
    out = string.concat(out, "</Name><Prefix>")
    out = string.concat(out, xml_escape(prefix))
    out = string.concat(out, "</Prefix><KeyCount>")
    out = string.concat(out, string.from_int(key_count))
    out = string.concat(out, "</KeyCount><MaxKeys>")
    out = string.concat(out, string.from_int(max_keys))
    out = string.concat(out, "</MaxKeys><IsTruncated>")
    if is_truncated == 1 { out = string.concat(out, "true") }
    else { out = string.concat(out, "false") }
    out = string.concat(out, "</IsTruncated>")
    return out
}

list_bucket_contents_xml(key: string, last_modified: string, etag: string, size: int) -> string {
    out = "<Contents><Key>"
    out = string.concat(out, xml_escape(key))
    out = string.concat(out, "</Key><LastModified>")
    out = string.concat(out, last_modified)
    out = string.concat(out, "</LastModified><ETag>&quot;")
    out = string.concat(out, etag)
    out = string.concat(out, "&quot;</ETag><Size>")
    out = string.concat(out, string.from_int(size))
    out = string.concat(out, "</Size><StorageClass>STANDARD</StorageClass></Contents>")
    return out
}

list_bucket_v2_close() -> string {
    return "</ListBucketResult>"
}

initiate_mpu_xml(bucket: string, key: string, upload_id: string) -> string {
    out = xml_decl()
    out = string.concat(out, "<InitiateMultipartUploadResult xmlns=\"")
    out = string.concat(out, XMLNS)
    out = string.concat(out, "\"><Bucket>")
    out = string.concat(out, xml_escape(bucket))
    out = string.concat(out, "</Bucket><Key>")
    out = string.concat(out, xml_escape(key))
    out = string.concat(out, "</Key><UploadId>")
    out = string.concat(out, xml_escape(upload_id))
    out = string.concat(out, "</UploadId></InitiateMultipartUploadResult>")
    return out
}

complete_mpu_xml(location: string, bucket: string, key: string, etag: string) -> string {
    out = xml_decl()
    out = string.concat(out, "<CompleteMultipartUploadResult xmlns=\"")
    out = string.concat(out, XMLNS)
    out = string.concat(out, "\"><Location>")
    out = string.concat(out, xml_escape(location))
    out = string.concat(out, "</Location><Bucket>")
    out = string.concat(out, xml_escape(bucket))
    out = string.concat(out, "</Bucket><Key>")
    out = string.concat(out, xml_escape(key))
    out = string.concat(out, "</Key><ETag>&quot;")
    out = string.concat(out, etag)
    out = string.concat(out, "&quot;</ETag></CompleteMultipartUploadResult>")
    return out
}

copy_object_xml(last_modified: string, etag: string) -> string {
    out = xml_decl()
    out = string.concat(out, "<CopyObjectResult xmlns=\"")
    out = string.concat(out, XMLNS)
    out = string.concat(out, "\"><LastModified>")
    out = string.concat(out, last_modified)
    out = string.concat(out, "</LastModified><ETag>&quot;")
    out = string.concat(out, etag)
    out = string.concat(out, "&quot;</ETag></CopyObjectResult>")
    return out
}

delete_result_open() -> string {
    out = xml_decl()
    out = string.concat(out, "<DeleteResult xmlns=\"")
    out = string.concat(out, XMLNS)
    out = string.concat(out, "\">")
    return out
}

delete_result_deleted_xml(key: string) -> string {
    out = "<Deleted><Key>"
    out = string.concat(out, xml_escape(key))
    out = string.concat(out, "</Key></Deleted>")
    return out
}

delete_result_close() -> string {
    return "</DeleteResult>"
}

location_constraint_xml(region: string) -> string {
    out = xml_decl()
    out = string.concat(out, "<LocationConstraint xmlns=\"")
    out = string.concat(out, XMLNS)
    out = string.concat(out, "\">")
    out = string.concat(out, xml_escape(region))
    out = string.concat(out, "</LocationConstraint>")
    return out
}

// Multipart ETag: md5(concat of binary part-md5s) + "-" + count.
// part_etags is a '\n'-joined list of hex md5 part etags (quotes stripped).
// Returns (etag, "") or ("", err).
multipart_etag(part_etags_joined: string) -> {
    if string.length(part_etags_joined) == 0 {
        return "", "no parts"
    }
    parts = string.split(part_etags_joined, "\n")
    n = string.array_size(parts)
    // concat raw md5 bytes
    combined = ""
    total = 0
    i = 0
    while i < n {
        et = _unquote(string.array_get(parts, i))
        raw = _hex_to_bytes(et)
        combined = string.concat(combined, raw)
        total = total + 16
        i = i + 1
    }
    string.array_free(parts)
    final_hex, e = cryptography.md5_hex(combined, total)
    if e != "" { return "", e }
    out = string.concat(final_hex, "-")
    out = string.concat(out, string.from_int(n))
    return out, ""
}

_unquote(s: string) -> string {
    n = string.length(s)
    if n >= 2 {
        if string.char_at(s, 0) == 34 {
            if string.char_at(s, n - 1) == 34 {
                return string.substring(s, 1, n - 1)
            }
        }
    }
    return s
}

// hex string -> raw bytes (length-aware string). Reuses the hmac module's
// nibble decode is private, so inline a small decoder here.
_hex_to_bytes(hex: string) -> string {
    n = string.length(hex)
    out_len = n / 2
    buf = bytes.new(out_len)
    i = 0
    while i < out_len {
        hi = _nib(string.char_at_n(hex, n, i * 2))
        lo = _nib(string.char_at_n(hex, n, i * 2 + 1))
        bytes.set(buf, i, hi * 16 + lo)
        i = i + 1
    }
    return bytes.finish(buf, out_len)
}

_nib(c: int) -> int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 97 + 10 }
    if c >= 65 && c <= 70 { return c - 65 + 10 }
    return 0
}
