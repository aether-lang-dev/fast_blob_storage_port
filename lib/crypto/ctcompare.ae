// lib.crypto.ctcompare — constant-time hex comparison.
//
// MODERNIZED (ae 0.260.0): the HMAC-SHA256 implementation that used to
// live here moved to std.cryptography (hmac_sha256_hex / hmac_sha256_bytes,
// landed in response to the port's ask #631). All that remains is
// equal_hex — a constant-time string compare for signature verification,
// which std doesn't provide (it's not an HMAC, just a timing-safe ==).
//
// RENAMED from `hmac` (ae 0.542.0): the test lib root is a FLAT root of
// bare basenames, so an `hmac.ae` there outranked std's own
// `std.cryptography.hmac` submodule. 0.542's std.cryptography delegates
// hmac_sha256_hex to that submodule, so the shadow broke every caller
// with "'hmac_sha256_hex' is not exported from module 'hmac'". The
// module holds no HMAC any more, so the honest name also fixes the clash.

import std.string

exports (equal_hex)

// Constant-time-ish hex string comparison: compares every char with no
// early-exit on mismatch. Returns 1 if equal, 0 otherwise. Used to
// verify signatures/MACs without a timing side channel.
equal_hex(a: string, b: string) -> int {
    la = string.length(a)
    lb = string.length(b)
    if la != lb { return 0 }
    diff = 0
    i = 0
    while i < la {
        ca = string.char_at_n(a, la, i)
        cb = string.char_at_n(b, lb, i)
        if ca != cb { diff = diff + 1 }
        i = i + 1
    }
    if diff == 0 { return 1 }
    return 0
}
