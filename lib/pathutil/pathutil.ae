// lib.pathutil — lexical path helpers matching Go path/filepath for
// the slash-separated POSIX paths the storage layer uses. Aether's
// std.fs has join/dirname/basename but no Clean/Rel/within-base, which
// the storage path-sanitisation logic depends on.
//
//   pathutil.clean(p)                 -> Go filepath.Clean (POSIX)
//   pathutil.is_within_base(base, t)  -> 1 if cleaned t == base or under base/
//   pathutil.first_element(p)         -> first path segment of cleaned p
//   pathutil.join(a, b)               -> clean(a + "/" + b)
//
// The segment stack is a std.collections StringList (string_list_add
// @retain-copies each segment, so it survives the split array's free —
// *StringSeq does NOT retain dynamic concat results, only literals).

import std.string
import std.collections (*)

exports (clean, is_within_base, first_element, join)

// Lexical clean: collapse `.`, resolve `..` against a segment stack,
// drop empty segments (// -> /), preserve a leading "/" and leading
// ".." that can't be resolved. Mirrors Go filepath.Clean for '/' paths.
clean(p: string) -> string {
    if string.length(p) == 0 { return "." }

    rooted = 0
    if string.char_at(p, 0) == 47 { rooted = 1 }   // leading '/'

    parts = string.split(p, "/")
    n = string.array_size(parts)

    stack = string_list_new()

    i = 0
    while i < n {
        part = string.array_get(parts, i)
        if string.length(part) == 0 {
            // empty (from // or leading/trailing /) — skip
        } else {
            if string.equals(part, ".") == 1 {
                // skip
            } else {
                if string.equals(part, "..") == 1 {
                    sz = string_list_size(stack)
                    head = ""
                    if sz > 0 { head = string_list_get(stack, sz - 1) }
                    if sz > 0 && string.equals(head, "..") == 0 {
                        string_list_remove(stack, sz - 1)
                    } else {
                        if rooted == 0 {
                            string_list_add(stack, "..")
                        }
                        // rooted: ".." at root is dropped (matches Go)
                    }
                } else {
                    string_list_add(stack, string.copy(part))
                }
            }
        }
        i = i + 1
    }
    string.array_free(parts)

    depth = string_list_size(stack)
    body = ""
    j = 0
    while j < depth {
        seg = string_list_get(stack, j)
        if j == 0 {
            body = string.copy(seg)
        } else {
            body = string.concat(body, string.concat("/", seg))
        }
        j = j + 1
    }
    string_list_free(stack)

    if rooted == 1 {
        if depth == 0 { return "/" }
        return string.concat("/", body)
    }
    if depth == 0 { return "." }
    return body
}

// join(a, b) = clean(a + "/" + b)
join(a: string, b: string) -> string {
    if string.length(a) == 0 { return clean(b) }
    if string.length(b) == 0 { return clean(a) }
    return clean(string.concat(a, string.concat("/", b)))
}

// first_element: first segment of cleaned p ("" for "." or "").
first_element(p: string) -> string {
    c = clean(p)
    if string.equals(c, ".") == 1 { return "" }
    if string.length(c) == 0 { return "" }
    start = 0
    if string.char_at(c, 0) == 47 { start = 1 }
    rest = string.substring(c, start, string.length(c))
    slash = string.index_of(rest, "/")
    if slash < 0 { return rest }
    return string.substring(rest, 0, slash)
}

// is_within_base: 1 if cleaned target equals base or sits under base + "/".
// Both inputs are expected already-absolute. Matches Go isWithinBase
// (rel != ".." and not "../"-prefixed).
is_within_base(base: string, target: string) -> int {
    b = clean(base)
    t = clean(target)
    if string.equals(b, t) == 1 { return 1 }
    prefix = string.concat(b, "/")
    if string.starts_with(t, prefix) == 1 { return 1 }
    return 0
}
