// lib.pathutil — lexical path helpers.
//
// MODERNIZED (ae 0.260.0): `clean` and `is_within_base` — the
// security-critical, traversal-defense logic this module used to
// hand-roll (a 116-line cons-list filepath.Clean reimplementation) —
// now delegate to std.fs.clean / std.fs.is_within_base, which landed in
// response to the port's ask (#632). Only `join` (clean-after-concat)
// and `first_element` remain as thin local conveniences; std.fs has
// `path_join` but it does NOT clean, and no `first_element`.

import std.string
import std.fs

exports (clean, is_within_base, first_element, join)

// Raw extern: std.fs.path_join is a bare extern (the qualified `fs.`
// wrappers don't expose it), and unlike pathutil.join it does not clean.
extern path_join(path1: string, path2: string) -> string

// Lexical clean — Go filepath.Clean POSIX semantics, now from std.fs.
clean(p: string) -> string {
    return fs.clean(p)
}

// 1 if cleaned target sits under / equals cleaned base — std.fs.
is_within_base(base: string, target: string) -> int {
    return fs.is_within_base(base, target)
}

// join(a, b) = clean(a + "/" + b). std path_join doesn't clean, so we
// clean the result — preserving this module's original contract that
// e.g. join("bucket", "a/../b") == "bucket/b".
join(a: string, b: string) -> string {
    if string.length(a) == 0 { return clean(b) }
    if string.length(b) == 0 { return clean(a) }
    return clean(path_join(a, b))
}

// first_element: first path segment of cleaned p ("" for "." or "").
// No std equivalent.
first_element(p: string) -> string {
    c = clean(p)
    if string.equals(c, ".") == 1 { return "" }
    if string.length(c) == 0 { return "" }
    start = 0
    if string.char_at(c, 0) == 47 { start = 1 }
    rest = string.substring(c, start, string.length(c))
    slash = string.index_of(rest, "/")
    if slash < 0 { return rest }
    return string.substring(rest, 0, slash)
}
