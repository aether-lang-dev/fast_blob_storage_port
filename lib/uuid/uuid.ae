// lib.uuid — opaque unique identifiers for storage paths, object IDs,
// upload IDs and token secrets. Go used github.com/google/uuid; Aether
// stdlib has none, so we generate hex strings from a PRNG re-seeded per
// call with the monotonic nanosecond clock (which advances every call,
// so successive seeds differ). Uniqueness — not cryptographic strength
// — is what the storage layer needs: file names are opaque.
//
//   uuid.new_hex(n)  -> 2n lowercase hex chars
//   uuid.new_uuid()  -> 36-char 8-4-4-4-12 dashed form (object/user IDs)

import std.math
import std.os
import std.string
import std.bytes

exports (new_hex, new_uuid)

const HEX = "0123456789abcdef"

// Re-seed from the monotonic clock mixed with wall micros. Called once
// per id; the monotonic ns value advances between calls so the PRNG
// stream does not repeat.
_reseed() {
    ns = os.now_monotonic_ns()
    micros = os.wall_micros()
    math.random_seed(ns + micros)
}

// Generate `n` random bytes worth of lowercase hex (2*n chars).
new_hex(n: int) -> string {
    _reseed()
    buf = bytes.new(n * 2)
    i = 0
    while i < n {
        b = math.random_int(0, 255)
        hi = b / 16
        lo = b - hi * 16
        bytes.set(buf, i * 2, string.char_at(HEX, hi))
        bytes.set(buf, i * 2 + 1, string.char_at(HEX, lo))
        i = i + 1
    }
    return bytes.finish(buf, n * 2)
}

// Generate a dashed 36-char UUID-shaped string (8-4-4-4-12).
new_uuid() -> string {
    out = string.concat(new_hex(4), "-")
    out = string.concat(out, new_hex(2))
    out = string.concat(out, "-")
    out = string.concat(out, new_hex(2))
    out = string.concat(out, "-")
    out = string.concat(out, new_hex(2))
    out = string.concat(out, "-")
    out = string.concat(out, new_hex(6))
    return out
}
