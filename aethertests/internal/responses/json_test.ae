// Integration test for internal/responses/responses.ae.
//
// A bare server `res` ptr can't be inspected off-server (the client
// accessors read uninitialised fields), so we stand up a live
// 1-process server with two routes that call responses.write_json,
// hit them with the v2 client, and assert status / body / headers.

import std.spec
import std.http
import std.http.client
import std.http.client.httptest
import responses

extern http_server_start_background_raw(server: ptr) -> int
extern http_server_port(server: ptr) -> int
extern sleep(ms: int)

// Route A: default cache policy.
handle_plain(req: ptr, res: ptr, ud: ptr) {
    responses.write_json(res, 200, "{\"hello\":\"world\"}", responses.CACHE_DEFAULT)
}

// Route B: no-store cache policy + 201.
handle_nostore(req: ptr, res: ptr, ud: ptr) {
    responses.write_json(res, 201, "{\"created\":true}", responses.CACHE_NO_STORE)
}

_get(port: int, path: string) -> ptr {
    base = "http://127.0.0.1:"
    url = "${base}${port}${path}"
    req = client.request("GET", url)
    client.set_timeout(req, 3s)
    resp, err = client.send_request(req)
    client.request_free(req)
    return resp
}

main() {
    fw = spec.init()

    s = http.server_create(0)
    http.server_set_host(s, "127.0.0.1")
    http.server_get(s, "/plain", handle_plain, 0)
    http.server_get(s, "/nostore", handle_nostore, 0)
    http_server_start_background_raw(s)
    sleep(200)
    port = http_server_port(s)

    spec.describe(fw, "responses.write_json") {

        spec.it("default: 200, JSON body, JSON content-type, no cache header") callback {
            resp = _get(port, "/plain")
            httptest.expect_http_status(resp, 200, "status 200")
            httptest.expect_http_body_contains(resp, "\"hello\":\"world\"", "body")
            ct = client.response_header(resp, "Content-Type")
            spec.assert_str_eq(ct, "application/json; charset=utf-8", "content-type")
            cc = client.response_header(resp, "Cache-Control")
            spec.assert_str_eq(cc, "", "no cache-control on default")
            client.response_free(resp)
        }

        spec.it("no-store: 201, body, Cache-Control no-store, Pragma no-cache") callback {
            resp = _get(port, "/nostore")
            httptest.expect_http_status(resp, 201, "status 201")
            httptest.expect_http_body_contains(resp, "\"created\":true", "body")
            cc = client.response_header(resp, "Cache-Control")
            spec.assert_str_eq(cc, "no-store", "cache-control")
            pragma = client.response_header(resp, "Pragma")
            spec.assert_str_eq(pragma, "no-cache", "pragma")
            client.response_free(resp)
        }
    }

    http.server_stop(s)
    spec.run_summary(fw)
}
