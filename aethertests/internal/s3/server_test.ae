// End-to-end S3 server integration test: stand up the real handler
// module against an in-memory DB + temp data dir, seed a bearer user +
// bucket, and drive the full object lifecycle over HTTP.

import aeocha
import std.http
import std.http.client
import schema
import users
import auth
import s3server
import contrib.sqlite
import std.string
import std.cryptography

import multipart

extern http_server_start_background_raw(server: ptr) -> int
extern http_server_port(server: ptr) -> int
extern sleep(ms: int)

const TOKEN = "AKIATEST.secretvalue"

// Extract the substring between `open` and `close` markers ("" if absent).
_between(s: string, open: string, close: string) -> string {
    i = string.index_of(s, open)
    if i < 0 { return "" }
    start = i + string.length(open)
    rest = string.substring(s, start, string.length(s))
    j = string.index_of(rest, close)
    if j < 0 { return "" }
    return string.substring(rest, 0, j)
}

// Issue a GET/PUT/DELETE with bearer auth, return the v2 response ptr.
_req(method: string, port: int, path: string, body: string) -> ptr {
    base = "http://127.0.0.1:"
    url = "${base}${port}${path}"
    r = client.request(method, url)
    client.set_timeout(r, 5s)
    client.set_header(r, "Authorization", "Bearer AKIATEST.secretvalue")
    if string.length(body) > 0 {
        client.set_body(r, body, string.length(body), "application/octet-stream")
    }
    resp, err = client.send_request(r)
    client.request_free(r)
    return resp
}

// Issue a streaming GET with bearer auth, return the v2 response ptr.
_req_stream_get(port: int, path: string) -> ptr {
    base = "http://127.0.0.1:"
    url = "${base}${port}${path}"
    r = client.request("GET", url)
    client.set_timeout(r, 5s)
    client.set_header(r, "Authorization", "Bearer AKIATEST.secretvalue")
    resp, err = client.send_stream(r)
    client.request_free(r)
    return resp
}

main() {
    fw = aeocha.init()

    db, oerr = schema.open_db(":memory:")
    // seed bearer user: secret_hash = sha256("secretvalue")
    hash = auth.hash_secret("secretvalue")
    users.user_insert(db, "u1", "Admin", "AKIATEST", hash, "", "", "admin", 1, "", "")

    data_dir = string.concat("/tmp/fbs_s3srv_", cryptography.random_hex(6)!)

    s = http.server_create(0)
    http.server_set_host(s, "127.0.0.1")
    ctx = s3server.set_state(db, data_dir)
    s3server.register_routes(s, ctx)
    http_server_start_background_raw(s)
    sleep(250)
    port = http_server_port(s)

    // 1. unauthenticated list -> 403
    r0 = client.request("GET", "http://127.0.0.1:${port}/")
    client.set_timeout(r0, 5s)
    resp0, e0 = client.send_request(r0)
    client.request_free(r0)
    st_unauth = client.response_status(resp0)
    client.response_free(resp0)

    // 2. create bucket
    rc = _req("PUT", port, "/mybucket", "")
    st_create = client.response_status(rc)
    client.response_free(rc)

    // 3. put object
    rp = _req("PUT", port, "/mybucket/hello.txt", "Hello, Aether S3!")
    st_put = client.response_status(rp)
    etag_hdr = string.copy(client.response_header(rp, "ETag"))
    // md5("Hello, Aether S3!") — proves the incremental digest is correct
    etag_ok = 0
    if string.equals(etag_hdr, "\"0f913c36c88a430584c253e987d5793c\"") == 1 { etag_ok = 1 }
    client.response_free(rp)

    // 4. get object
    rg = _req("GET", port, "/mybucket/hello.txt", "")
    st_get = client.response_status(rg)
    body_get = client.response_body(rg)
    body_ok = 0
    if string.equals(body_get, "Hello, Aether S3!") == 1 { body_ok = 1 }
    client.response_free(rg)

    // 5. head object
    rh = _req("HEAD", port, "/mybucket/hello.txt", "")
    st_head = client.response_status(rh)
    client.response_free(rh)

    // 6. list objects (v2)
    rl = _req("GET", port, "/mybucket?list-type=2", "")
    st_list = client.response_status(rl)
    body_list = client.response_body(rl)
    list_has_key = string.contains(body_list, "hello.txt")
    client.response_free(rl)

    // 7. get missing -> 404
    rm = _req("GET", port, "/mybucket/nope.txt", "")
    st_missing = client.response_status(rm)
    client.response_free(rm)

    // 8. delete object
    rd = _req("DELETE", port, "/mybucket/hello.txt", "")
    st_del = client.response_status(rd)
    client.response_free(rd)

    // 9. confirm gone
    rg2 = _req("GET", port, "/mybucket/hello.txt", "")
    st_gone = client.response_status(rg2)
    client.response_free(rg2)

    // --- multipart flow ---
    // 10. initiate
    ri = _req("POST", port, "/mybucket/multi.bin?uploads", "")
    st_init = client.response_status(ri)
    init_body = string.copy(client.response_body(ri))
    client.response_free(ri)
    // extract UploadId from <UploadId>...</UploadId>
    upid = _between(init_body, "<UploadId>", "</UploadId>")

    // 11. upload two parts
    p1url = "/mybucket/multi.bin?uploadId=${upid}&partNumber=1"
    rp1 = _req("PUT", port, p1url, "AAAAAAAAAA")
    st_p1 = client.response_status(rp1)
    client.response_free(rp1)
    p2url = "/mybucket/multi.bin?uploadId=${upid}&partNumber=2"
    rp2 = _req("PUT", port, p2url, "BBBBBBBBBB")
    st_p2 = client.response_status(rp2)
    client.response_free(rp2)

    // 12. complete
    curl = "/mybucket/multi.bin?uploadId=${upid}"
    rcm = _req("POST", port, curl, "<CompleteMultipartUpload></CompleteMultipartUpload>")
    st_complete = client.response_status(rcm)
    client.response_free(rcm)

    // 13. get assembled object
    rga = _req("GET", port, "/mybucket/multi.bin", "")
    st_assembled = client.response_status(rga)
    asm_body = string.copy(client.response_body(rga))
    asm_ok = 0
    if string.equals(asm_body, "AAAAAAAAAABBBBBBBBBB") == 1 { asm_ok = 1 }
    client.response_free(rga)

    // --- copy object ---
    rsrc = _req("PUT", port, "/mybucket/src.txt", "copy me")
    client.response_free(rsrc)
    rcp = client.request("PUT", "http://127.0.0.1:${port}/mybucket/dst.txt")
    client.set_timeout(rcp, 5s)
    client.set_header(rcp, "Authorization", "Bearer AKIATEST.secretvalue")
    client.set_header(rcp, "x-amz-copy-source", "/mybucket/src.txt")
    resp_cp, ecp = client.send_request(rcp)
    client.request_free(rcp)
    st_copy = client.response_status(resp_cp)
    client.response_free(resp_cp)
    rcpg = _req("GET", port, "/mybucket/dst.txt", "")
    copy_body = string.copy(client.response_body(rcpg))
    copy_ok = 0
    if string.equals(copy_body, "copy me") == 1 { copy_ok = 1 }
    client.response_free(rcpg)

    // --- bulk delete ---
    rbd = _req("POST", port, "/mybucket?delete", "<Delete><Object><Key>src.txt</Key></Object><Object><Key>dst.txt</Key></Object></Delete>")
    st_bulk = client.response_status(rbd)
    bulk_body = string.copy(client.response_body(rbd))
    bulk_ok = 0
    if string.contains(bulk_body, "src.txt") == 1 { bulk_ok = 1 }
    client.response_free(rbd)
    rchk = _req("GET", port, "/mybucket/src.txt", "")
    st_bulk_gone = client.response_status(rchk)
    client.response_free(rchk)

    // --- large object: exercise the streaming (>16KiB) upload path ---
    big = ""
    bi = 0
    while bi < 20000 { big = string.concat(big, "0123456789")  bi = bi + 1 }   // 200 KB
    rbig = _req("PUT", port, "/mybucket/big.bin", big)
    st_big_put = client.response_status(rbig)
    client.response_free(rbig)
    rbigg = _req_stream_get(port, "/mybucket/big.bin")
    st_big_get = client.response_status(rbigg)
    big_body = ""
    reading_big = 1
    while reading_big == 1 {
        chunk = client.response_read(rbigg, 65536)
        if string.length(chunk) == 0 {
            reading_big = 0
        } else {
            big_body = string.concat(big_body, chunk)
        }
    }
    big_ok = 0
    if string.equals(big_body, big) == 1 { big_ok = 1 }
    client.response_free(rbigg)

    http.server_stop(s)

    aeocha.describe(fw, "s3 server end-to-end") {
        aeocha.it("rejects unauthenticated") callback {
            aeocha.assert_eq(st_unauth, 403, "403 no auth")
        }
        aeocha.it("create bucket") callback {
            aeocha.assert_eq(st_create, 200, "200 created")
        }
        aeocha.it("put object returns ETag") callback {
            aeocha.assert_eq(st_put, 200, "200 put")
            aeocha.assert_eq(etag_ok, 1, "ETag is md5 of body (incremental digest)")
        }
        aeocha.it("get object returns body") callback {
            aeocha.assert_eq(st_get, 200, "200 get")
            aeocha.assert_eq(body_ok, 1, "body roundtrip")
        }
        aeocha.it("head object") callback {
            aeocha.assert_eq(st_head, 200, "200 head")
        }
        aeocha.it("list objects shows key") callback {
            aeocha.assert_eq(st_list, 200, "200 list")
            aeocha.assert_eq(list_has_key, 1, "key in listing")
        }
        aeocha.it("missing object 404") callback {
            aeocha.assert_eq(st_missing, 404, "404 missing")
        }
        aeocha.it("delete then gone") callback {
            aeocha.assert_eq(st_del, 204, "204 delete")
            aeocha.assert_eq(st_gone, 404, "404 after delete")
        }
        aeocha.it("multipart upload assembles") callback {
            aeocha.assert_eq(st_init, 200, "200 initiate")
            aeocha.assert_eq(st_p1, 200, "200 part1")
            aeocha.assert_eq(st_p2, 200, "200 part2")
            aeocha.assert_eq(st_complete, 200, "200 complete")
            aeocha.assert_eq(st_assembled, 200, "200 get assembled")
            aeocha.assert_eq(asm_ok, 1, "parts concatenated in order")
        }
        aeocha.it("copy object") callback {
            aeocha.assert_eq(st_copy, 200, "200 copy")
            aeocha.assert_eq(copy_ok, 1, "copy body matches source")
        }
        aeocha.it("large object streams + roundtrips") callback {
            aeocha.assert_eq(st_big_put, 200, "200 big put")
            aeocha.assert_eq(st_big_get, 200, "200 big get")
            aeocha.assert_eq(big_ok, 1, "200KB body byte-identical")
        }
        aeocha.it("bulk delete") callback {
            aeocha.assert_eq(st_bulk, 200, "200 bulk delete")
            aeocha.assert_eq(bulk_ok, 1, "delete result lists key")
            aeocha.assert_eq(st_bulk_gone, 404, "objects gone")
        }
    }

    aeocha.run_summary(fw)
}
