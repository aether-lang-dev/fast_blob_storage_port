import aeocha
import signer

// Port of internal/publicread/signer_test.go. The fixture matches the
// Go test exactly (secret, timestamps), and the expected signature is
// the byte-identical output of the Go signer.SignPath for the same
// inputs (cross-checked: `go run` of the real internal/publicread).

const SECRET = "12345678901234567890123456789012"
const NOW_UNIX = 1778666400          // 2026-05-13 10:00:00 UTC
const EXP_UNIX = 1778670000          // now + 1h
const EXP_STR = "1778670000"
// signer.SignPath(ObjectPath("my bucket","folder/a+b.txt"), EXP) per Go:
const GO_SIG = "bd8bb140b5a66dc11101501125283703450a202ead8cb46777626167a64e7b0e"

main() {
    fw = aeocha.init()

    aeocha.describe(fw, "publicread.signer") {

        aeocha.it("ObjectPath escapes segments, preserves slashes") callback {
            got = signer.object_path("my bucket", "folder/a+b/c d.txt")
            aeocha.assert_str_eq(fw, got, "/public/my%20bucket/folder/a+b/c%20d.txt", "objpath")
        }

        aeocha.it("SignPath matches Go reference (parity)") callback {
            path = signer.object_path("my bucket", "folder/a+b.txt")
            got = signer.sign_path(SECRET, path, EXP_UNIX)
            aeocha.assert_str_eq(fw, got, GO_SIG, "sig parity")
        }

        aeocha.it("Verify accepts a valid signature") callback {
            path = signer.object_path("my bucket", "folder/a+b.txt")
            sig = signer.sign_path(SECRET, path, EXP_UNIX)
            err = signer.verify(SECRET, path, EXP_STR, sig, NOW_UNIX)
            aeocha.assert_str_eq(fw, err, "", "valid")
        }

        aeocha.it("Verify rejects malformed signature") callback {
            path = signer.object_path("my bucket", "folder/a+b.txt")
            err = signer.verify(SECRET, path, EXP_STR, "bad", NOW_UNIX)
            aeocha.assert_str_eq(fw, err, signer.ERR_MALFORMED, "malformed")
        }

        aeocha.it("Verify rejects an invalid (wrong-path) signature") callback {
            path = signer.object_path("my bucket", "folder/a+b.txt")
            wrong = signer.sign_path(SECRET, "/different", EXP_UNIX)
            err = signer.verify(SECRET, path, EXP_STR, wrong, NOW_UNIX)
            aeocha.assert_str_eq(fw, err, signer.ERR_INVALID, "invalid")
        }

        aeocha.it("Verify rejects an expired signature") callback {
            path = signer.object_path("my bucket", "folder/a+b.txt")
            // expires in the past relative to NOW_UNIX
            past = "1778666399"
            sig = signer.sign_path(SECRET, path, 1778666399)
            err = signer.verify(SECRET, path, past, sig, NOW_UNIX)
            aeocha.assert_str_eq(fw, err, signer.ERR_EXPIRED, "expired")
        }

        aeocha.it("new_secret rejects short secrets") callback {
            s, err = signer.new_secret("tooshort")
            aeocha.assert_str_eq(fw, err, signer.ERR_DISABLED, "short")
        }

        aeocha.it("new_secret accepts a 32-byte secret") callback {
            s, err = signer.new_secret(SECRET)
            aeocha.assert_str_eq(fw, err, "", "ok")
        }
    }

    aeocha.run_summary(fw)
}
