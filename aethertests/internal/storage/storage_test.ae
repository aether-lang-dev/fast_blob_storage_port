import std.spec
import storage
import std.string
import std.fs
import std.bytes

// Unique-ish temp data dir for this run (uuid avoids cross-run clashes).
import std.cryptography


main() {
    fw = spec.init()

    base = string.concat("/tmp/fbs_storage_test_", cryptography.random_hex(6)!)
    data_dir, nerr = storage.new(base)

    spec.describe(fw, "storage.validate_key") {
        spec.it("accepts valid keys") callback {
            spec.assert_str_eq(storage.validate_key("file.txt"), "", "file.txt")
            spec.assert_str_eq(storage.validate_key("a/b/c.txt"), "", "nested")
            spec.assert_str_eq(storage.validate_key("photos/2024/image.jpg"), "", "deep")
        }
        spec.it("rejects empty/dot/dotdot/absolute") callback {
            spec.assert_str_eq(storage.validate_key(""), storage.ERR_INVALID_KEY, "empty")
            spec.assert_str_eq(storage.validate_key("."), storage.ERR_INVALID_KEY, "dot")
            spec.assert_str_eq(storage.validate_key(".."), storage.ERR_INVALID_KEY, "dotdot")
            spec.assert_str_eq(storage.validate_key("/tmp/x"), storage.ERR_INVALID_KEY, "abs")
        }
        spec.it("flags traversal") callback {
            spec.assert_str_eq(storage.validate_key("../etc/passwd"), storage.ERR_PATH_TRAVERSAL, "trav")
            spec.assert_str_eq(storage.validate_key("a/../../b"), storage.ERR_PATH_TRAVERSAL, "nested trav")
        }
        spec.it("rejects control chars") callback {
            // Build "bad\x00key" via a byte buffer — string.concat is
            // strlen-bounded and would truncate at the embedded NUL.
            nb = bytes.new(7)
            bytes.set(nb, 0, 98)
            bytes.set(nb, 1, 97)
            bytes.set(nb, 2, 100)
            bytes.set(nb, 3, 0)
            bytes.set(nb, 4, 107)
            bytes.set(nb, 5, 101)
            bytes.set(nb, 6, 121)
            nul = bytes.finish(nb, 7)
            spec.assert_str_eq(storage.validate_key(nul), storage.ERR_INVALID_KEY, "nul")
            nl = string.concat("bad", string.concat(string.from_char(10), "key"))
            spec.assert_str_eq(storage.validate_key(nl), storage.ERR_INVALID_KEY, "newline")
        }
    }

    spec.describe(fw, "storage write/read/delete") {
        spec.it("roundtrips an object") callback {
            payload = "hello aether storage"
            plen = string.length(payload)
            sp, size, werr = storage.write(data_dir, "mybucket", "docs/readme.txt", payload, plen)
            spec.assert_str_eq(werr, "", "write ok")
            size_ok = 0
            if size == plen { size_ok = 1 }
            spec.assert_eq(size_ok, 1, "size echoed")

            got, glen, rerr = storage.read(data_dir, sp)
            spec.assert_str_eq(rerr, "", "read ok")
            spec.assert_eq(glen, plen, "read len")
            spec.assert_str_eq(got, payload, "read content")

            derr = storage.delete_object(data_dir, sp)
            spec.assert_str_eq(derr, "", "delete ok")

            _, _, rerr2 = storage.read(data_dir, sp)
            spec.assert_str_eq(rerr2, storage.ERR_NOT_FOUND, "gone after delete")
        }

        spec.it("delete is idempotent") callback {
            sp, size, werr = storage.write(data_dir, "b2", "x.bin", "abc", 3)
            storage.delete_object(data_dir, sp)
            derr = storage.delete_object(data_dir, sp)
            spec.assert_str_eq(derr, "", "second delete no error")
        }

        spec.it("rejects write with bad key") callback {
            _, _, werr = storage.write(data_dir, "b", "../escape", "x", 1)
            spec.assert_str_eq(werr, storage.ERR_PATH_TRAVERSAL, "traversal blocked")
        }

        spec.it("rejects storage path escape on read") callback {
            _, _, rerr = storage.read(data_dir, "../outside.txt")
            spec.assert_str_eq(rerr, storage.ERR_PATH_TRAVERSAL, "escape blocked")
        }
    }

    spec.run_summary(fw)
}
