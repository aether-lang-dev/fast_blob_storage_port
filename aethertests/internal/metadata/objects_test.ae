import std.spec
import schema
import objects
import contrib.sqlite
import std.string

main() {
    fw = spec.init()
    db, oerr = schema.open_db(":memory:")
    sqlite.exec(db, "INSERT INTO users (id, display_name, access_key_id, secret_hash, role) VALUES ('u','U','ak','sh','admin')")
    sqlite.exec(db, "INSERT INTO buckets (name, owner_id) VALUES ('b','u')")

    // upsert insert
    c1 = objects.object_upsert(db, "o1", "b", "k1.txt", 10, "etag1", "text/plain", "b/sp1", "", "")
    ins_ok = 0
    if c1 == "" { ins_ok = 1 }

    // get back
    o1, gerr = objects.object_get(db, "b", "k1.txt")
    get_ok = 0
    if gerr == "" && o1.size == 10 && string.equals(o1.etag, "etag1") == 1 && string.equals(o1.content_type, "text/plain") == 1 { get_ok = 1 }

    // upsert overwrite (same bucket/key, new size/etag)
    objects.object_upsert(db, "o2", "b", "k1.txt", 20, "etag2", "", "b/sp2", "", "")
    o2, _ = objects.object_get(db, "b", "k1.txt")
    over_ok = 0
    if o2.size == 20 && string.equals(o2.etag, "etag2") == 1 && string.equals(o2.storage_path, "b/sp2") == 1 { over_ok = 1 }

    // exists
    ex = objects.object_exists(db, "b", "k1.txt")
    ex_ghost = objects.object_exists(db, "b", "nope")

    // pagination: insert k2..k5, list with max_keys=2 -> truncated
    objects.object_upsert(db, "oa", "b", "k2.txt", 1, "e", "", "b/a", "", "")
    objects.object_upsert(db, "ob", "b", "k3.txt", 1, "e", "", "b/b", "", "")
    objects.object_upsert(db, "oc", "b", "k4.txt", 1, "e", "", "b/c", "", "")
    keys, trunc = objects.object_list_keys(db, "b", "", "", 2)
    page_match = 0
    if string.equals(keys, "k1.txt\nk2.txt") == 1 && trunc == 1 { page_match = 1 }

    // start_after pagination
    keys2, trunc2 = objects.object_list_keys(db, "b", "", "k2.txt", 10)
    after_match = 0
    if string.equals(keys2, "k3.txt\nk4.txt") == 1 && trunc2 == 0 { after_match = 1 }

    // prefix filter
    objects.object_upsert(db, "op", "b", "photos/x.jpg", 1, "e", "", "b/p", "", "")
    keys3, _ = objects.object_list_keys(db, "b", "photos/", "", 10)
    prefix_match = 0
    if string.equals(keys3, "photos/x.jpg") == 1 { prefix_match = 1 }

    // delete
    derr = objects.object_delete(db, "b", "k1.txt")
    del_ok = 0
    if derr == "" { del_ok = 1 }
    ex_after = objects.object_exists(db, "b", "k1.txt")

    spec.describe(fw, "metadata.objects") {
        spec.it("upsert insert + get") callback {
            spec.assert_eq(ins_ok, 1, "inserted")
            spec.assert_eq(get_ok, 1, "fields match")
        }
        spec.it("upsert overwrite") callback {
            spec.assert_eq(over_ok, 1, "overwritten")
        }
        spec.it("exists") callback {
            spec.assert_eq(ex, 1, "present")
            spec.assert_eq(ex_ghost, 0, "absent")
        }
        spec.it("pagination truncation") callback {
            spec.assert_eq(page_match, 1, "2 keys + truncated")
        }
        spec.it("start_after pagination") callback {
            spec.assert_eq(after_match, 1, "keys after k2")
        }
        spec.it("prefix filter") callback {
            spec.assert_eq(prefix_match, 1, "only photos/")
        }
        spec.it("delete") callback {
            spec.assert_eq(del_ok, 1, "deleted")
            spec.assert_eq(ex_after, 0, "gone")
        }
    }

    return spec.run_summary(fw)
}
