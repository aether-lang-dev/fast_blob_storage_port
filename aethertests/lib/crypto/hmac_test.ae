import aeocha
import hmac

// lib/crypto/hmac is now just the constant-time hex compare (the
// HMAC-SHA256 moved to std.cryptography, tested upstream). SigV4 HMAC
// parity is still asserted end-to-end in sigv4_test.ae + auth_test.ae.
main() {
    fw = aeocha.init()
    aeocha.describe(fw, "hmac.equal_hex (constant-time compare)") {
        aeocha.it("equal strings match") callback {
            aeocha.assert_eq(hmac.equal_hex("deadbeef", "deadbeef"), 1, "eq")
        }
        aeocha.it("different strings reject") callback {
            aeocha.assert_eq(hmac.equal_hex("deadbeef", "deadbee0"), 0, "neq")
        }
        aeocha.it("different lengths reject") callback {
            aeocha.assert_eq(hmac.equal_hex("ab", "abcd"), 0, "len")
        }
    }
    aeocha.run_summary(fw)
}
