import aeocha
import uuid
import std.string
main() {
    fw = aeocha.init()
    aeocha.describe(fw, "uuid") {
        aeocha.it("new_hex length") callback {
            h = uuid.new_hex(16)
            aeocha.assert_eq(fw, string.length(h), 32, "32 hex chars")
        }
        aeocha.it("new_uuid format 36 chars") callback {
            u = uuid.new_uuid()
            aeocha.assert_eq(fw, string.length(u), 36, "36 chars")
        }
        aeocha.it("two ids differ") callback {
            a = uuid.new_uuid()
            b = uuid.new_uuid()
            aeocha.assert_eq(fw, string.equals(a, b), 0, "distinct")
        }
    }
    aeocha.run_summary(fw)
}
